# Copy to .env next to the compose file you use. Every line is optional.
# STRATA_IMAGE=strata:0.2.7-cuda13     # only to use an image you built yourself (docker/build.sh); the default is the published ghcr.io/niko1221/strata image
# MODEL=IQ3_XXS
# MODEL_PATH=/models                        # with a volume line  - /srv/gguf/IQ3_XXS:/models:ro
# CONTEXT=32k
# PARALLEL=2
# VISION=off
# TUNE=skip
# STAY_UP=1                             # 1: keep the container up while the server is not running, so a model can be switched in it: docs/DOCKER.md "Changing the model at runtime" (also add healthcheck: { disable: true } to the compose file for that workflow)
# API_KEY=put-a-long-random-key-here        # openssl rand -hex 24
# STRATA_BIND=127.0.0.1                     # 0.0.0.0 = reachable from your network (then use a real API_KEY)
# STRATA_PORT=8080
# RENDER_GID=                               # AMD / Intel only: getent group render | cut -d: -f3
# STRATA_DATA_DIR=/mnt/big/strata           # docker-compose.cuda-src.yml only: the folder /data maps to, when the named volume has no room
# STRATA_COMMIT=                            # docker-compose.cuda-src.yml only: the build needs it, use git rev-parse HEAD
